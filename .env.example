# My Book Reader — environment variables (copy to .env and fill in).
# V1 works fully offline: NO variable is required to run the app.
# Never commit your real .env file.

# --- V2: cloud sync / backup with Supabase (optional, not used yet) ---
# Only the public "anon" key may be used in the app. Never put the service_role key here.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# --- V4: AI assistant (optional, not used yet) ---
# AI calls must go through your own backend (e.g. a Supabase Edge Function):
# never embed provider API keys in the mobile app bundle.
EXPO_PUBLIC_AI_BACKEND_URL=
